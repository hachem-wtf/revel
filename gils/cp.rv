# copy a file not cyberpunk
# HAAAAAANNNNKKKK

const context = env.ctx

if context.argv:len() < 3 do
  fail("usage: cp <source> <destination>\n")
end else do
  const source = expand_path(context.argv[1])
  const destination = expand_path(context.argv[2])
  const size = vfs:size(source)

  if size < 0 do
    fail("cp: #{source}: no such file\n")
  end else do
    const contents = if (size > 0) vfs:read_bytes(source, 0, size) else ""
    if (vfs:store(destination, contents) == 1)
      puts("#{source} -> #{destination}\n")
  end
end
