fn seed_bin() do
  fs:mkdir("/bin")
  fs:mkdir("/usr/bin")
  for index in 0..prog_count() do
    fs:store("/usr/bin/#{prog_name(index)}", phys_to_str(prog_phys(index), prog_size(index)))
  end
  for index in 0..script_count() do
    fs:store("/bin/#{script_name(index)}.rv", script_src(index))
  end
end

fn seed_fonts() do
  fs:mkdir("/usr/share")
  for index in 0..font_count() do
    fs:store("/usr/share/#{font_name(index)}", phys_to_str(font_phys(index), font_size(index)))
  end
end

fn seed_fs() do
  fs:mkdir("/usr")
  fs:mkdir("/etc")
  fs:mkdir("/home")

  for index in 0..etc_count() do
    fs:store("/etc/#{etc_name(index)}", etc_src(index))
  end
  fs:store("/home/balls.txt", "its lowk insane how big my balls are lol jk\n\t- hachem")
  fs:store("/home/i have big balls.txt", "dude my balls are actually massive lol jk\n\t- hachem")

  seed_bin()
  seed_fonts()
end
