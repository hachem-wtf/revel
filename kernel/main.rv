# kmain
pic_remap()
pit_init()

pic_unmask(0) # pit      (irq0) -> cursor blink / uptime
pic_unmask(1) # keyboard (irq1)

wipe()
dump_memmap()

fs:mount()
if (disk_sectors() != 0 and fs.ready == :false) do
  puts("blank disk, formatting + seeding default files\n")
  fs:format()
  seed_fs()
end

if fs:size("/etc/profile") >= 0 do
  run_script_path("/etc/profile", "profile", make_ctx("", { "" }))
end

# lung will be happy
const default_face = load_ttf("/fonts/terminess.ttf", 32)
if default_face != :nil do
  add_font("terminess", default_face.glyphs, default_face.width, default_face.height, :ttf, "/fonts/terminess.ttf", 32)
  console:set_font(find_font("terminess"))
end

welcome()
flush_console()
