# kmain
pic_remap()
pit_init()

pic_unmask(0) # pit      (irq0) -> cursor blink / uptime
pic_unmask(1) # keyboard (irq1)

cmd_clear()
dump_memmap()

fs_init()
if disk_sectors() == 0 puts("no disk attached\n")
else if fs.ready puts("mounted revelfs on disk\n")
else do
  # blank disk, first boot after a clone. format it and drop the default files on
  puts("blank disk, formatting + seeding default files\n")
  fs_format()
  seed_fs()
end

puts("revel shell, live in revo. type `help`\n% ")
flush_console()
